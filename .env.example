# ==============================================================================
# EGX Real-Time Watchlist & Terminal — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure your personal parameters.
# NEVER commit your active .env file to public version control.

# Local Network Binding (Strictly loopback for local security)
HOST=127.0.0.1
PORT=8000

# Market Data Feed Adapter ('tradingview' or 'egxapi')
DATA_PROVIDER=tradingview

# TradingView WebSocket Provider
# (Optional: Leave empty for default anonymous session; provide your token for real-time delayless feed)
TV_AUTH_TOKEN=your_tradingview_session_token_here_or_leave_empty

# EGXApi.com Provider
# (Optional: Provide your personal egxapi.com API key if DATA_PROVIDER=egxapi)
EGX_API_KEY=your_egx_api_key_here

# Egyptian Exchange Schedule Guard (Cairo Time: Sun-Thu 10:00 - 14:30)
MARKET_TIMEZONE=Africa/Cairo
MARKET_OPEN_HOUR=10
MARKET_OPEN_MINUTE=0
MARKET_CLOSE_HOUR=14
MARKET_CLOSE_MINUTE=30

# Allowed CORS Origins (Strictly restricted to localhost ports)
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000,http://localhost:8000
