# ==============================================================================
# Strict Git Ignore Configuration for EGX Real-Time Watchlist & Terminal
# ==============================================================================

# 1. Environment & Sensitive Credentials (CRITICAL)
.env
.env.local
.env.*.local
*.env
*.secret
!.env.example

# 2. Local Databases & SQLite Caches (CRITICAL)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
egx_watchlist.db
backend/egx_watchlist.db

# 3. Python Bytecode, Caches & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
.installed.cfg
*.egg

# 4. Node / Frontend Dependencies & Bundles
node_modules/
frontend/node_modules/
dist/
build/
frontend/dist/
frontend/build/
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 5. Executable Bundles & PyInstaller Artifacts
*.spec
*.exe
dist/EGX_Tracker.exe
build/EGX_Tracker/

# 6. IDE, Editors & OS Files
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
desktop.ini

# 7. Logs & Temporary Scratch Dumps
*.log
logs/
tmp/
scratch/
